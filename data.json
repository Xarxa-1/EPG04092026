:35+01:00","durada":"00:49:22","drets_cat":"yes","drets_esp":"yes","drets_mon":"yes","tematica":"144","classificacio":{"grup_id":"3","grup":"DIVULGACI\u00d3","subgrup_id":"32","subgrup":"MAGAZINE ESPECIALITZAT","tematica_dvb":"144"},"target_id":"4","target":"TOTS ELS P\u00daBLICS","codi_etic":"TP","qualificacions":"","destacat":"no","destacat_text":"","destacat_imatge":"","hashtag":"","codi_hashtag":"","audio_descripcio":"yes","subtitulat_catala":"yes","subtitulat_vo":"no","logo":"33","reemissio":"yes","id_programa":"59096"},"despres_fem":{"codi_canal":"c33","tipus":"tv","codi_op":"6002338","capitol":"118","graella":"11465139","codi_programa":"511529","titol_programa":"Qu\u00e8quicom","titol_capitol":"La bicicleta: una m\u00e0quina perfecta","titol_tdt":"Qu\u00e8quicom - La bicicleta: una m\u00e0quina perfecta","sinopsi":"Avui, mostrem la perfecci\u00f3 de la bicicleta com a m\u00e0quina. Sota el t\u00edtol general 'Bicicleta: la m\u00e0quina perfecta', i amb la col\u00b7laboraci\u00f3 del campi\u00f3 Melcior Mauri, el programa cient\u00edfic del 33 n'oferir\u00e0 els detalls: consumeix 40 vegades menys que el cotxe i la seva fabricaci\u00f3 estalvia 100 vegades m\u00e9s energia que l'autom\u00f2bil. \u00c9s tamb\u00e9 el mitj\u00e0 de transport m\u00e9s r\u00e0pid en dist\u00e0ncies inferiors als 8 quil\u00f2metres i, a m\u00e9s, el seu \u00fas \u00e9s saludable.Al llarg del programa, el reporter Pere Renom participar\u00e0 en la classe de 'spinning' (bicicleta est\u00e0tica) m\u00e9s multitudin\u00e0ria del m\u00f3n per constatar els beneficis sobre el sistema cardiovascular d'aquest esport. M\u00e9s tard s'iniciar\u00e0 en la bicicleta de muntanya (BTT) amb Israel N\u00fa\u00f1ez, 6 vegades campi\u00f3 d'Espanya i campi\u00f3 de la Titan Desert. La BTT \u00e9s una modalitat molt explosiva i t\u00e8cnica pel fet que es practica en terrenys molt irregulars. Israel N\u00fa\u00f1ez dedica molt temps a la muntanya per conservar la t\u00e8cnica, per\u00f2 la major part de l'entrenament el fa a la carretera, que \u00e9s la disciplina reina del ciclisme esportiu. I un dels grans ciclistes dels \u00faltims temps \u00e9s Melcior Mauri. Especialista en contrarellotge, Mauri va aconseguir 52 vict\u00f2ries com a professional. Sap qu\u00e8 \u00e9s posar el cos al l\u00edmit. El premi a l'esfor\u00e7 \u00e9s que, de vegades, s'aconsegueix ser l'esportista perfecte damunt la m\u00e0quina perfecta.","start_time":"2026-11-03T17:31:35+01:00","end_time":"2026-11-03T17:58:06+01:00","durada":"00:26:31","drets_cat":"yes","drets_esp":"yes","drets_mon":"yes","tematica":"144","classificacio":{"grup_id":"3","grup":"DIVULGACI\u00d3","subgrup_id":"32","subgrup":"MAGAZINE ESPECIALITZAT","tematica_dvb":"144"},"target_id":"4","target":"TOTS ELS P\u00daBLICS","codi_etic":"TP","qualificacions":"","destacat":"no","destacat_text":"","destacat_imatge":"","hashtag":"","codi_hashtag":"","audio_descripcio":"no","subtitulat_catala":"yes","subtitulat_vo":"no","logo":"33","reemissio":"yes","id_programa":"201630493"}},{"@attributes":{"name":"oca1"},"ara_fem":"","despres_fem":""},{"@attributes":{"name":"oca2"},"ara_fem":"","despres_fem":""},{"@attributes":{"name":"oca3"},"ara_fem":"","despres_fem":""},{"@attributes":{"name":"oca4"},"ara_fem":{"codi_canal":"oca4","tipus":"tv","codi_op":"6011251","capitol":"4214","graella":"11506120","codi_programa":"517338","titol_programa":"Compareixen\u00e7a al Congr\u00e9s del ministre Puente","titol_capitol":"","titol_tdt":"Compareixen\u00e7a al Congr\u00e9s del ministre Puente","sinopsi":"","start_time":"2026-11-03T17:06:28+01:00","end_time":"2026-11-03T20:06:23+01:00","durada":"02:59:55","drets_cat":"yes","drets_esp":"yes","drets_mon":"yes","tematica":"32","classificacio":{"grup_id":"1","grup":"ACTUALITAT","subgrup_id":"15","subgrup":"RETRANSMISSIONS ACTUALITAT","tematica_dvb":"32"},"target_id":"4","target":"TOTS ELS P\u00daBLICS","codi_etic":"","qualificacions":"","destacat":"yes","destacat_text":"","destacat_imatge":"https:\/\