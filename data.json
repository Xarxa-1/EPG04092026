ci\u00f3.","start_time":"2026-11-07T03:15:50+01:00","end_time":"2026-11-07T03:47:35+01:00","durada":"00:31:45","drets_cat":"yes","drets_esp":"yes","drets_mon":"yes","tematica":"0","classificacio":{"grup_id":"4","grup":"ENTRETENIMENT","subgrup_id":"40","subgrup":"ALTRES","tematica_dvb":"0"},"target_id":"4","target":"TOTS ELS P\u00daBLICS","codi_etic":"TP","qualificacions":"","destacat":"no","destacat_text":"","destacat_imatge":"","hashtag":"","codi_hashtag":"","audio_descripcio":"no","subtitulat_catala":"yes","subtitulat_vo":"no","logo":"33","reemissio":"yes","id_programa":"60096"}},{"@attributes":{"name":"oca1"},"ara_fem":"","despres_fem":""},{"@attributes":{"name":"oca2"},"ara_fem":"","despres_fem":""},{"@attributes":{"name":"oca3"},"ara_fem":"","despres_fem":""},{"@attributes":{"name":"oca4"},"ara_fem":"","despres_fem":""}]}