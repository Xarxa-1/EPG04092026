shtag":"","audio_descripcio":"no","subtitulat_catala":"yes","subtitulat_vo":"no","logo":"SX3","reemissio":"yes","id_programa":"65156"}},{"@attributes":{"name":"c33"},"ara_fem":{"codi_canal":"c33","tipus":"tv","codi_op":"6016606","capitol":"7","graella":"11427844","codi_programa":"527465","titol_programa":"Els hotels m\u00e9s remots del m\u00f3n","titol_capitol":"Budir - Isl\u00e0ndia","titol_tdt":"Els hotels m\u00e9s remots del m\u00f3n - Budir - Isl\u00e0ndia","sinopsi":"Situat enmig d'un camp de lava a la part oest m\u00e9s remota d'Isl\u00e0ndia, l'hotel Budir existeix des dels anys 40. Propietat d'un empresari local, dur al damunt la hist\u00f2ria d'aquestes terres desolades, i el personal, que no ha canviat des de fa anys, prov\u00e9 del mateix poble de la pen\u00ednsula. Atrau clients habituals que utilitzen l'hotel com un lloc de retir davant de l'oce\u00e0 Atl\u00e0ntic. Es creu que Jules Vernes va localitzar l'escenari d'un dels seus llibres, 'Viatge al centre de la terra', just al costat de la ic\u00f2nica esgl\u00e9sia negra que hi ha al davant de l'hotel.","start_time":"2026-10-02T16:35:34+02:00","end_time":"2026-10-02T17:04:21+02:00","durada":"00:28:47","drets_cat":"yes","drets_esp":"yes","drets_mon":"no","tematica":"144","classificacio":{"grup_id":"3","grup":"DIVULGACI\u00d3","subgrup_id":"31","subgrup":"DOCUMENTAL DE DIVULGACI\u00d3","tematica_dvb":"144"},"target_id":"4","target":"TOTS ELS P\u00daBLICS","codi_etic":"TP","destacat":"no","destacat_text":"","destacat_imatge":"","hashtag":"","codi_hashtag":"","audio_descripcio":"no","subtitulat_catala":"yes","subtitulat_vo":"no","logo":"33","reemissio":"yes","id_programa":"74556"},"despres_fem":{"codi_canal":"c33","tipus":"tv","codi_op":"6016606","capitol":"8","graella":"11427844","codi_programa":"527465","titol_programa":"Els hotels m\u00e9s remots del m\u00f3n","titol_capitol":"Qasr Al Sarab d'Anantara - Emirats \u00c0rabs Units","titol_tdt":"Els hotels m\u00e9s remots del m\u00f3n - Qasr Al Sarab d'Anantara - Emirats \u00c0rabs Units","sinopsi":"Enclavat en una vall des\u00e8rtica enmig d'immenses dunes, i davant d'unes salines, l'hotel destaca amb les seves torres de pedra, grans enreixats i fonts d'aigua, recordant una antiga fortalesa \u00e0rab. Qasr Al Sarab \u00e9s pr\u00e0cticament l'\u00fanica estructura en un radi de diversos quil\u00f2metres: un vaixell solitari a la deriva en un mar de sorra. L'hotel, per tant, ha de satisfer les seves pr\u00f2pies necessitats. L'hotel recicla tota la seva aigua, t\u00e9 la seva pr\u00f2pia planta de tractament i fins i tot cultiva les seves pr\u00f2pies fruites i verdures en un hivernacle al desert. Va ser elegit com el gran hotel m\u00e9s sostenible del m\u00f3n l'any 2022.","start_time":"2026-10-02T17:04:21+02:00","end_time":"2026-10-02T17:30:24+02:00","durada":"00:26:03","drets_cat":"yes","drets_esp":"yes","drets_mon":"no","tematica":"144","classificacio":{"grup_id":"3","grup":"DIVULGACI\u00d3","subgrup_id":"31","subgrup":"DOCUMENTAL DE DIVULGACI\u00d3","tematica_dvb":"144"},"target_id":"4","target":"TOTS ELS P\u00daBLICS","codi_etic":"TP","destacat":"no","destacat_text":"","destacat_imatge":"","hashtag":"","codi_hashtag":"","audio_descripcio":"no","subtitulat_catala":"yes","subtitulat_vo":"no","logo":"33","reemissio":"yes","id_programa":"74556"}},{"@attributes":{"name":"oca1"},"ara_fem":"","despres_fem":""},{"@attributes":{"name":"oca2"},"ara_fem":"","despres_fem":""},{"@attributes":{"name":"oca3"},"ara_fem":"","despres_fem":""},{"@attributes":{"name":"oca4"},"ara_fem":"","despres_fem":""}]}