a molt forta, i hi ha xamans que hi van regularment per iniciar els viatgers i els adeptes al ioga.","start_time":"2026-11-09T00:14:52+01:00","end_time":"2026-11-09T00:40:28+01:00","durada":"00:25:36","drets_cat":"yes","drets_esp":"yes","drets_mon":"no","tematica":"144","classificacio":{"grup_id":"3","grup":"DIVULGACI\u00d3","subgrup_id":"31","subgrup":"DOCUMENTAL DE DIVULGACI\u00d3","tematica_dvb":"144"},"target_id":"4","target":"TOTS ELS P\u00daBLICS","codi_etic":"TP","qualificacions":"","destacat":"no","destacat_text":"","destacat_imatge":"","hashtag":"","codi_hashtag":"","audio_descripcio":"no","subtitulat_catala":"yes","subtitulat_vo":"no","logo":"33","reemissio":"yes","id_programa":"74556"},"despres_fem":{"codi_canal":"c33","tipus":"tv","codi_op":"6016606","capitol":"6","graella":"11483278","codi_programa":"527465","titol_programa":"Els hotels m\u00e9s remots del m\u00f3n","titol_capitol":"Hoshi Onsen","titol_tdt":"Els hotels m\u00e9s remots del m\u00f3n - Hoshi Onsen","sinopsi":"\u00c9s un dels m\u00e9s antics del m\u00f3n i la mateixa fam\u00edlia gestiona aquest ryokan tradicional des de 1875 anys. A la vall verge del parc nacional de Joshintetsu, l'hostal atrau escriptors, pintors, a la recerca de la incre\u00efble serenitat d'aquest lloc. Els banys hist\u00f2rics de les fonts termals naturals del riu Hoshi, constru\u00efts al voltant d'una antiga estructura de fusta, s\u00f3n molt coneguts al Jap\u00f3 i completen la sensaci\u00f3 d'haver estat enviat en un segle m\u00e9s. Tot el personal \u00e9s de la regi\u00f3 de Gunma i viu amb la fam\u00edlia dins de l'hostal, compartint la incre\u00efble tradici\u00f3 d'hospitalitat amb els hostes. Apassionat per les espases, el fill del propietari \u00e9s artes\u00e0 en un taller ancestral del poble ve\u00ed, i a l'hotel se'n conserven alguns exemples rars i originals.","start_time":"2026-11-09T00:40:28+01:00","end_time":"2026-11-09T01:07:39+01:00","durada":"00:27:11","drets_cat":"yes","drets_esp":"yes","drets_mon"