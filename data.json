"codi_op":"6011571","capitol":"87","graella":"11458521","codi_programa":"517498","titol_programa":"Prodigiosa: Les aventures de Ladybug i Gat Noir","titol_capitol":"Gabriel Agreste","titol_tdt":"Prodigiosa: Les aventures de Ladybug i Gat Noir - Gabriel Agreste","sinopsi":"El Nathaniel i el Marc expliquen als amics que han pensat un pla perqu\u00e8 la Marinette declari el seu amor a l'Adrien. El pla s'ha de dur a terme a l'institut, que \u00e9s l'\u00fanic lloc on el pare de l'Adrien no el controla. Per\u00f2 la Chlo\u00e9 grava la reuni\u00f3 i els amena\u00e7a d'explicar-ho tot al Gabriel perqu\u00e8 no deixi tornar l'Adrien a l'institut mai m\u00e9s. La Chlo\u00e9 est\u00e0 convidada a una festa a casa del Gabriel, l'\u00fanic lloc on la Marinette no pot entrar. Per sort compten amb la imaginaci\u00f3 del Nathaniel i del Marc. La Marinette es disfressa de cambrer i entra a casa dels Agreste d'inc\u00f2gnit, per\u00f2 tamb\u00e9 s'hi presenta un supermalvat. Aconseguir\u00e0 salvar la festa, Ladybug?","start_time":"2026-10-23T02:06:03+02:00","end_time":"2026-10-23T02:27:17+02:00","durada":"00:21:14","drets_cat":"yes","drets_esp":"yes","drets_mon":"no","tematica":"85","classificacio":{"grup_id":"5","grup":"FICCI\u00d3","subgrup_id":"54","subgrup":"S\u00c8RIE DIBUIXOS ANIMATS","tematica_dvb":"85"},"target_id":"1","target":"INFANTIL","codi_etic":"TP","qualificacions":"","destacat":"no","destacat_text":"","destacat_imatge":"","hashtag":"","codi_hashtag":"","audio_descripcio":"yes","subtitulat_catala":"yes","subtitulat_vo":"no","logo":"SX3","reemissio":"yes","id_programa":"55097"}},{"@attributes":{"name":"c33"},"ara_fem":{"codi_canal":"c33","tipus":"tv","codi_op":"6016029","capitol":"6","graella":"11447862","codi_programa":"527448","titol_programa":"Diaris fotogr\u00e0fics","titol_capitol":"Berta Vicente","titol_tdt":"Diaris fotogr\u00e0fics - Berta Vicente","sinopsi":"Sinopsis cap\u00edtol 6: Berta Vicente","start_time":"2026-10-23T01:58:25+02:00","end_time":"2026-10-2