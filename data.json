9536"}},{"@attributes":{"name":"c33"},"ara_fem":{"codi_canal":"c33","tipus":"tv","codi_op":"6012977","capitol":"1","graella":"11444429","codi_programa":"518792","titol_programa":"Fabra, diccionari d'un home sense biografia","titol_capitol":"Fabra, diccionari d'un home sense biografia - Fabra, diccionari d'un home sense biografia","titol_tdt":"Fabra, diccionari d'un home sense biografia","sinopsi":"\u00abFabra, diccionari d'un home sense biografia\u00bb \u00e9s un documental que parla de llengua, de comprom\u00eds i de 80 anys cabdals de la hist\u00f2ria de Catalunya. I ho fa trav\u00e9s de la vida d'un personatge irrepetible: Pompeu Fabra, el pare del catal\u00e0 modern.Pompeu Fabra va ser la persona que va recosir una llengua fragmentada per convertir-la en una eina apte per a tots els usos. Per\u00f2 lluny de la imatge de rigidesa ling\u00fc\u00edstica a la s'associa la seva figura, Fabra va ser un personatge modern, intel\u00b7lectualment brillant i connectat amb els corrents intel\u00b7lectuals de la seva \u00e8poca.","start_time":"2026-09-20T13:41:13+02:00","end_time":"2026-09-20T14:33:16+02:00","durada":"00:52:03","drets_cat":"yes","drets_esp":"yes","drets_mon":"yes","tematica":"35","classificacio":{"grup_id":"1","grup":"ACTUALITAT","subgrup_id":"16","subgrup":"DOCUMENTAL","tematica_dvb":"35"},"target_id":"4","target":"TOTS ELS P\u00daBLICS","codi_etic":"TP","destacat":"yes","destacat_text":"","destacat_imatge":"https:\/\/img.3cat.cat\/multimedia\/jpg\/2\/3\/1556034684832.jpg","hashtag":"","codi_hashtag":"","audio_descripcio":"no","subtitulat_catala":"yes","subtitulat_vo":"no","logo":"33","reemissio":"yes","id_programa":"0"},"despres_fem":{"codi_canal":"c33","tipus":"tv","codi_op":"6013001","capitol":"7","graella":"11442208","codi_programa":"518646","titol_programa":"Volcans i homes","titol_capitol":"Volcans i homes - El Bromo, el volc\u00e0 sagrat de Java","titol_tdt":"Volcans i homes - El Bromo, el volc\u00e0 sagrat de Java","sinopsi":"En aquest episodi, Arnaud Gu\u00e9rin, ge\u00f2leg i fot\u00f2graf professional, ens porta a Indon\u00e8sia, a l'illa de Java. Entre d'altres coses, l'acompanyarem en la seva visita al volc\u00e0 Bromo, aprofitant que \u00e9s l'\u00e8poca de la festa de Kesodo, en qu\u00e8 es fan ofrenes al volc\u00e0, un costum que es mant\u00e9 desde l'antiguitat. Astoko, un agricultor de les f\u00e8rtils terres que envolten el volc\u00e0 i que ha viscut sempre aqu\u00ed, li explicar\u00e0 costums locals i li far\u00e0 de guia en la cerim\u00f2nia i els rituals.","start_time":"2026-09-20T14:33:16+02:00","end_time":"2026-09-20T14:59:23+02:00","durada":"00:26:07","drets_cat":"yes","drets_esp":"yes","drets_mon":"no","tematica":"144","classificacio":{"grup_id":"3","grup":"DIVULGACI\u00d3","subgrup_id":"31","subgrup":"DOCUMENTAL DE DIVULGACI\u00d3","tematica_dvb":"144"},"target_id":"4","target":"TOTS ELS P\u00daBLICS","codi_etic":"TP","destacat":"no","destacat_text":"","destacat_imatge":"","hashtag":"","codi_hashtag":"","audio_descripcio":"no","subtitulat_catala":"yes","subtitulat_vo":"no","logo":"33","reemissio":"yes","id_programa":"75256"}},{"@attributes":{"name":"oca1"},"ara_fem":{"codi_canal":"oca1","tipus":"tv","codi_op":"5000990","capitol":"8131","graella":"11453543","codi_programa":"521394","titol_programa":"Acte esportiu","titol_capitol":"- Festa al cel","titol_tdt":"Acte esportiu - Festa al cel","sinopsi":"Aquest festival aeri \u00e9s el m\u00e9s antic i important de l'Estat espanyol. El campionat d'aviaci\u00f3, que en els \u00faltims anys s'ha consolidat a Salou, \u00e9s tot un espectacle de velocitat, per\u00edcia i tecnologia. La Festa al Cel.","start_time":"2026-09-20T12:00:00+02:00","end_time":"2026-09-20T14:59:55+02:00","durada":"02:59:55","drets_cat":"yes","drets_esp":"yes","drets_mon":"no","tematica":"65","classificacio":{"grup_id":"2","grup":"ESPORTS","subgrup_id":"25","subgrup":"RETRANSMISSIONS ESPORTS","tematica_dvb":"65"},"target_id":"4","target":"TOTS ELS P\u00daBLICS","codi_etic":"",