ts_cat":"yes","drets_esp":"yes","drets_mon":"no","tematica":"85","classificacio":{"grup_id":"5","grup":"FICCI\u00d3","subgrup_id":"54","subgrup":"S\u00c8RIE DIBUIXOS ANIMATS","tematica_dvb":"85"},"target_id":"1","target":"INFANTIL","codi_etic":"TP","qualificacions":"","destacat":"no","destacat_text":"","destacat_imatge":"","hashtag":"","codi_hashtag":"","audio_descripcio":"no","subtitulat_catala":"yes","subtitulat_vo":"no","logo":"SX3","reemissio":"yes","id_programa":"47136"},"despres_fem":{"codi_canal":"sx3","tipus":"tv","codi_op":"6007995","capitol":"4","graella":"11502061","codi_programa":"515257","titol_programa":"Els germans Kratt","titol_capitol":"El vol del drag\u00f3","titol_tdt":"Els germans Kratt - El vol del drag\u00f3","sinopsi":"En Chris i en Martin, que han sortit d'excursi\u00f3 a buscar dragons voladors, han acabat descobrint el pla mal\u00e8fic de l'encara m\u00e9s mal\u00e8fica Donita Donata. T\u00e9 intenci\u00f3 de fer servir dragons voladors per crear la nova col\u00b7lecci\u00f3 de tardor de les joies vivents! Per aturar-la, hauran d'incorporar el poder del drag\u00f3 al Vestit de Poder Animal! T'ho perdr\u00e0s?!","start_time":"2026-11-16T12:26:18+01:00","end_time":"2026-11-16T12:47:18+01:00","durada":"00:21:00","drets_cat":"yes","drets_esp":"yes","drets_mon":"no","tematica":"85","classificacio":{"grup_id":"5","grup":"FICCI\u00d3","subgrup_id":"54","subgrup":"S\u00c8RIE DIBUIXOS ANIMATS","tematica_dvb":"85"},"target_id":"1","target":"INFANTIL","codi_etic":"TP","qualificacions":"","destacat":"no","destacat_text":"","destacat_imatge":"","hashtag":"","codi_hashtag":"","audio_descripcio":"no","subtitulat_catala":"yes","subtitulat_vo":"no","logo":"SX3","reemissio":"yes","id_programa":"47136"}},{"@attributes":{"name":"c33"},"ara_fem":{"codi_canal":"c33","tipus":"tv","codi_op":"6013086","capitol":"6","graella":"11488306","codi_programa":"518898","titol_programa":"Gent de mercats","titol_capitol":"Mercat Municipal de Sitges, Mercat Central de Tarragona i Mercat d'Horta a Barcelona","titol_tdt":"Gent de mercats - Mercat Municipal de Sitges, Mercat Central de Tarragona i Mercat d'Horta a Barcelona","sinopsi":"En aquest cap\u00edtol ens sumarem a l'Ester i la Vinyet, mare i filla, en la seva trobada setmanal al mercat de Sitges, i amb elles aprendrem com es fa un aut\u00e8ntic arr\u00f2s a la sitgetana. All\u00e0 ens trobarem amb el Ricky, un cuiner angl\u00e8s tatuat fins a les celles (literalment) conven\u00e7ut que la galeria del producte fresc que \u00e9s el mercat \u00e9s el millor reclam per acostar la cuina catalana als visitants de la poblaci\u00f3. El mercat de Sitges tamb\u00e9 hi trobem una parada de venda directa de fruita i horta, la del Daniel, un excomercial que ven el que produeixen els camps que conrea. L'acompanyarem a Mercabarna, on hi ha la cooperativa de pagesos d'agricultura ecol\u00f2gica de la qual \u00e9s soci per endur-se el que necessita i ell no t\u00e9. Al mercat Central de Tarragona seguirem el Josep en les seves tres ocupacions, la de llibreter, la de venedor de pastissos al mercat i la de casteller, tot un senyor de Tarragona! Si encara no ho heu fet, us convidem a sentir com sona el carill\u00f3 i a con\u00e8ixer la Carmeta, una peixatera nascuda al Serrallo molt pessimista amb l'estat actual de la mar. Tamb\u00e9 visitarem el mercat d'Horta, a Barcelona, on coneixerem l'Eva, la florista del mercat, poc conven\u00e7uda de la reforma integral que s'hi ha de fer, i al pessebrista oficial, que reprodueix les parades en figuretes. Finalment, comprarem n\u00fameros per a una rifa que involucra tot el mercat. Tot aix\u00f2 acompanyat de moltes m\u00e9s hist\u00f2ries de la nostra Gent de Mercats!","start_time":"2026-11-16T11:37:39+01:00","end_time":"2026-11-16T12:24:18+01:00","durada":"00:46:39","drets_cat":"yes","drets_esp":"yes","drets_mon":"yes","tematica":"144","classificacio":{"grup_id":"3","grup":"DIVULGACI\u00d3","subgrup_id":"31","subgrup":"DOCUMENTAL DE DIVULGACI\u00d3","tematica