yes","drets_mon":"no","tematica":"85","classificacio":{"grup_id":"5","grup":"FICCI\u00d3","subgrup_id":"54","subgrup":"S\u00c8RIE DIBUIXOS ANIMATS","tematica_dvb":"85"},"target_id":"1","target":"INFANTIL","codi_etic":"TP","destacat":"no","destacat_text":"","destacat_imatge":"","hashtag":"","codi_hashtag":"","audio_descripcio":"no","subtitulat_catala":"yes","subtitulat_vo":"no","logo":"SX3","reemissio":"yes","id_programa":"71656"}},{"@attributes":{"name":"c33"},"ara_fem":{"codi_canal":"c33","tipus":"tv","codi_op":"6007637","capitol":"2","graella":"11384081","codi_programa":"514962","titol_programa":"Fotografies","titol_capitol":"Animals","titol_tdt":"Fotografies - Animals","sinopsi":"El programa acompanya I\u00f1aki Relanz\u00f3n, un dels grans fot\u00f2grafs catalans de vida salvatge, en una excursi\u00f3 per fotografiar ocells a les illes Farne, al nord d'Anglaterra; un grup d'aficionats a la macrofotografia de l'Agrupaci\u00f3 Fotogr\u00e0fica de Catalunya mostra la seva passi\u00f3 per capturar la natura m\u00e9s petita; i 'Fotografies' recupera la 'Fauna Secreta' de Joan Fontcuberta i Pere Formiguera.Camuflatge, observaci\u00f3, paci\u00e8ncia i proximitat. Quatre elements imprescindibles per dedicar-se a la fotografia d'animals, una mirada fotogr\u00e0fica a la naturalesa que ha canviat molt en el temps. En aquest cap\u00edtol viatjarem amb I\u00f1aki Relanz\u00f3n a les illes Farne, a Anglaterra, per a una sessi\u00f3 fotogr\u00e0fica excepcional. A m\u00e9s a m\u00e9s, coneixerem les innovadores fotografies de naturalesa nocturna que George Shiras va fer a principis de segle, i l'exotisme de les fotografies de safaris fetes durant els anys 30 per Emili Juncadella, fot\u00f2graf aficionat catal\u00e0. Coneixerem tamb\u00e9 els originals retrats d'animals imaginaris que Joan Fontcuberta i Pere Formiguera van realitzar el 1987 per al projecte 'Fauna secreta'. La fotografia dels m\u00e9s petits detalls de la naturalesa la descobrirem gr\u00e0cies a un grup de fot\u00f2grafs aficionats de l'Agrupaci\u00f3 Fotogr\u00e0fica de Catalunya, reunits per a una sessi\u00f3 de macrofotografia, i al proc\u00e9s de microfotografia fet en un laboratori de la Universitat Polit\u00e8cnica de Catalunya.","start_time":"2026-09-26T08:32:47+02:00","end_time":"2026-09-26T08:58:47+02:00","durada":"00:26:00","drets_cat":"yes","drets_esp":"yes","drets_mon":"no","tematica":"144","classificacio":{"grup_id":"3","grup":"DIVULGACI\u00d3","subgrup_id":"31","subgrup":"DOCUMENTAL DE DIVULGACI\u00d3","tematica_dvb":"144"},"target_id":"4","target":"TOTS ELS P\u00daBLICS","codi_etic":"TP","destacat":"no","destacat_text":"","destacat_imatge":"","hashtag":"","codi_hashtag":"","audio_descripcio":"no","subtitulat_catala":"yes","subtitulat_vo":"no","logo":"33","reemissio":"yes","id_programa":"46296"},"despres_fem":{"codi_canal":"c33","tipus":"tv","codi_op":"6011798","capitol":"10","graella":"11262133","codi_programa":"517691","titol_programa":"Viure als Pirineus- A banda i banda","titol_capitol":"Xavi Llongueras i Jean-Fran\u00e7ois Rechoulet - Hivern","titol_tdt":"Viure als Pirineus- A banda i banda - Xavi Llongueras i Jean-Fran\u00e7ois Rechoulet - Hivern","sinopsi":"","start_time":"2026-09-26T08:58:47+02:00","end_time":"2026-09-26T09:51:46+02:00","durada":"00:52:59","drets_cat":"yes","drets_esp":"yes","drets_mon":"yes","tematica":"0","classificacio":{"grup_id":"3","grup":"DIVULGACI\u00d3","subgrup_id":"31","subgrup":"DOCUMENTAL DE DIVULGACI\u00d3","tematica_dvb":"0"},"target_id":"4","target":"TOTS ELS P\u00daBLICS","codi_etic":"TP","destacat":"no","destacat_text":"","destacat_imatge":"","hashtag":"","codi_hashtag":"","audio_descripcio":"no","subtitulat_catala":"yes","subtitulat_vo":"no","logo":"33","reemissio":"yes","id_programa":"54956"}},{"@attributes":{"name":"oca1"},"ara_fem":"","despres_fem":""},{"@attributes":{"name":"oca2"},"ara_fem":"","despres_fem":""},{"@attributes":{"name":"oca3"},"ara_fem":"","despres_fem":""},{"@attributes":{"name":"oca4"},"ara_f