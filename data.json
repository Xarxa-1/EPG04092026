01:00","durada":"00:55:41","drets_cat":"yes","drets_esp":"yes","drets_mon":"yes","tematica":"66","classificacio":{"grup_id":"2","grup":"ESPORTS","subgrup_id":"26","subgrup":"DOCUMENTAL","tematica_dvb":"66"},"target_id":"4","target":"TOTS ELS P\u00daBLICS","codi_etic":"07","qualificacions":["conductes","llenguatge"],"destacat":"yes","destacat_text":"","destacat_imatge":"https:\/\/img.3cat.cat\/multimedia\/jpg\/6\/6\/1794307781366.jpg","hashtag":"","codi_hashtag":"","audio_descripcio":"yes","subtitulat_catala":"yes","subtitulat_vo":"no","logo":"DD","reemissio":"yes","id_programa":"0"}},{"@attributes":{"name":"sx3"},"ara_fem":{"codi_canal":"sx3","tipus":"tv","codi_op":"6011571","capitol":"29","graella":"11475938","codi_programa":"517498","titol_programa":"Prodigiosa: Les aventures de Ladybug i Gat Noir","titol_capitol":"Glaciator","titol_tdt":"Prodigiosa: Les aventures de Ladybug i Gat Noir - Glaciator","sinopsi":"La Marinette surt amb els seus amics a prendre un gelat, per\u00f2 al final l'Adrien no pot venir, perqu\u00e8 el seu pare no el deixa sortir. L'Andr\u00e9, el gelater dels enamorats li pronostica que acabar\u00e0 trobant el seu amor, per\u00f2 la Marinette no ho veu clar. I aquesta desconfian\u00e7a l'aprofitar\u00e0 l'Esfinx per crear un altre dels seus supermalvats.","start_time":"2026-11-11T19:19:52+01:00","end_time":"2026-11-11T19:42:05+01:00","durada":"00:22:13","drets_cat":"yes","drets_esp":"yes","drets_mon":"no","tematica":"85","classificacio":{"grup_id":"5","grup":"FICCI\u00d3","subgrup_id":"54","subgrup":"S\u00c8RIE DIBUIXOS ANIMATS","tematica_dvb":"85"},"target_id":"1","target":"INFANTIL","codi_etic":"TP","qualificacions":"","destacat":"no","destacat_text":"","destacat_imatge":"","hashtag":"","codi_hashtag":"","audio_descripcio":"yes","subtitulat_catala":"yes","subtitulat_vo":"no","logo":"SX3","reemissio":"yes","id_programa":"55097"},"despres_fem":{"codi_canal":"sx3","tipus":"tv","codi_op":"6011571","capitol":"30","graella":"11475938","codi_programa":"517498","titol_programa":"Prodigiosa: Les aventures de Ladybug i Gat Noir","titol_capitol":"L'osset de peluix malvat","titol_tdt":"Prodigiosa: Les aventures de Ladybug i Gat Noir - L'osset de peluix malvat","sinopsi":"L'Adrien li diu a la Chlo\u00e9 que si vol que segueixin sent amics, ha d'apendre a ser amable amb els altres. Per aix\u00f2 la Chlo\u00e9 organitza una festa a casa seva,per\u00f2 l'instint de criticar els altres \u00e9s m\u00e9s fort que ella, i el seu majordom intenta ajudar-la fent servir un osset de peluix de quan era petita. El problema \u00e9s quel'Esfinx tamb\u00e9 s'ha fixat en l'osset.","start_time":"2026-11-11T19:42:05+01:00","end_time":"2026-11-11T20:03:55+01:00","durada":"00:21:50","drets_cat":"yes","drets_esp":"yes","drets_mon":"no","tematica":"85","classificacio":{"grup_id":"5","grup":"FICCI\u00d3","subgrup_id":"54","subgrup":"S\u00c8RIE DIBUIXOS ANIMATS","tematica_dvb":"85"},"target_id":"1","target":"INFANTIL","codi_etic":"TP","qualificacions":"","destacat":"no","destacat_text":"","destacat_imatge":"","hashtag":"","codi_hashtag":"","audio_descripcio":"yes","subtitulat_catala":"yes","subtitulat_vo":"no","logo":"SX3","reemissio":"yes","id_programa":"55097"}},{"@attributes":{"name":"c33"},"ara_fem":{"codi_canal":"c33","tipus":"tv","codi_op":"6015629","capitol":"1","graella":"11488278","codi_programa":"521165","titol_programa":"Cam\u00ed de Marina","titol_capitol":"Cam\u00ed de Marina","titol_tdt":"Cam\u00ed de Marina","sinopsi":"'Cam\u00ed de Marina. Un conte sobre la voluntat' (2023), una producci\u00f3 de Aigua Films amb la participaci\u00f3 de Televisi\u00f3 de Catalunya, Fundaci\u00f3 Miranda, Xarxa per la Conservaci\u00f3 de la Natura, Diputaci\u00f3 de Barcelona, Fundaci\u00f3 Pau Costa, IDAPA, S\u00e8lvans, Consorci del Llu\u00e7an\u00e8s, Associaci\u00f3 Cam\u00ed Ramader de Marina i l'ICEC.Una dissecci\u00f3 del col\u00b7lapse territorial a partir de la primera transhum\u00e0ncia que es fa del Pirineu al mar en m\u00e9s de setanta anys pel recentment recuperat Cam\u00ed Ramader de Marina.Una road movie a ritme de cavall que ens posa davant el disseny i la gesti\u00f3 del territori de Catalunya -i per extensi\u00f3 de tota la Mediterr\u00e0nia-, tenint en compte els fluxos biol\u00f2gics de la fauna salvatge, la situaci\u00f3 dels boscos, els desastres dels Grans Incendis Forestals, la intensificaci\u00f3 agr\u00edcola i ramadera, l'estat de l'aigua i la biodiversitat.Direcci\u00f3: Carles Caparr\u00f3s i ObiolsGui\u00f3: Carles Caparr\u00f3s i ObiolsRealitzaci\u00f3: Sacha Soliman LatorreProductor: Carles Caparr\u00f3s i ObiolsProductor executiu TVC: David Bassa CabanasEdici\u00f3 continguts TVC:Agust\u00ed Argelich Giron\u00e8sProductor delegat TVC: Daniel Barea DelgadoDirector fotografia: Norman Garc\u00eda SoleraMuntatge: Laila Romero i TorrentDirector de producci\u00f3: Sacha Soliman LatorreM\u00fasica: Marian M\u00e1rquez Ruiz de GopeguiLing\u00fcista: Laia R\u00fabies i AmbitGrafisme: Miriam Sugranyes","start_time":"2026-11-11T19:03:45+01:00","end_time":"2026-11-11T20:06:50+01:00","durada":"01:03:05","drets_cat":"yes","drets_esp":"yes","drets_mon":"yes","tematica":"144","classificacio":{"grup_id":"3","grup":"DIVULGACI\u00d3","subgrup_id":"31","subgrup":"DOCUMENTAL DE DIVULGACI\u00d3","tematica_dvb":"144"},"target_id":"4","target":"TOTS ELS P\u00daBLICS","codi_etic":"TP","qualificacions":"","destacat":"yes","destacat_text":"","destacat_imatge":"https:\/\/img.3cat.cat\/multimedia\/jpg\/3\/3\/1699023172733.jpg","hashtag":"","codi_hashtag":"","audio_descripcio":"no","subtitulat_catala":"yes","subtitulat_vo":"no","logo":"33","reemissio":"yes","id_programa":"0"},"despres_fem":{"codi_canal":"c33","tipus":"tv","codi_op":"6014567","capitol":"3","graella":"11515519","codi_programa":"519812","titol_programa":"La veritat sobre la dictadura de Franco","titol_capitol":"L'hora zero","titol_tdt":"La veritat sobre la dictadura de Franco - L'hora zero","sinopsi":"La Segona Guerra Mundial ha acabat i els estats han de prendre partit entre els defensors i els detractors de la democr\u00e0cia. La indefinici\u00f3 de Franco deixa Espanya en una posici\u00f3 de greu a\u00efllament internacional. Per\u00f2 el 1953 el dictador firma un concordat amb la Santa Seu i uns acords amb els Estats Units pels quals accedeix a la instal\u00b7laci\u00f3 de bases militars nord-americanes al pa\u00eds a canvi d'ajuda econ\u00f2mica i militar. Espanya posa un peu a l'escenari internacional. N'hi haur\u00e0 prou per millorar les condicions de vida de milions de ciutadans que pateixen el seu r\u00e8gim opressor?","start_time":"2026-11-11T20:06:50+01:00","end_time":"2026-11-11T20:59:07+01:00","durada":"00:52:17","drets_cat":"yes","drets_esp":"yes","drets_mon":"no","tematica":"144","classificacio":{"grup_id":"3","grup":"DIVULGACI\u00d3","subgrup_id":"31","subgrup":"DOCUMENTAL DE DIVULGACI\u00d3","tematica_dvb":"144"},"target_id":"4","target":"TOTS ELS P\u00daBLICS","codi_etic":"10","qualificacions":"","destacat":"no","destacat_text":"","destacat_imatge":"","hashtag":"","codi_hashtag":"","audio_descripcio":"no","subtitulat_catala":"yes","subtitulat_vo":"no","logo":"33","reemissio":"yes","id_programa":"70976"}},{"@attributes":{"name":"oca1"},"ara_fem":"","despres_fem":""},{"@attributes":{"name":"oca2"},"ara_fem":"","despres_fem":""},{"@attributes":{"name":"oca3"},"ara_fem":"","despres_fem":""},{"@attributes":{"name":"oca4"},"ara_fem":"","despres_fem":""}]}