rdinador, perqu\u00e8 va ser un dels primers a dibuixar digitalment. Consells sobre com escollir uns prism\u00e0tics, avisos per l'ornit\u00f2leg ocasional...i el Caf\u00e8 Bar Ni Piu, el local de moda a Can Tocats.","start_time":"2026-11-04T09:01:43+01:00","end_time":"2026-11-04T09:31:52+01:00","durada":"00:30:09","drets_cat":"yes","drets_esp":"yes","drets_mon":"yes","tematica":"144","classificacio":{"grup_id":"3","grup":"DIVULGACI\u00d3","subgrup_id":"32","subgrup":"MAGAZINE ESPECIALITZAT","tematica_dvb":"144"},"target_id":"4","target":"TOTS ELS P\u00daBLICS","codi_etic":"TP","qualificacions":"","destacat":"no","destacat_text":"","destacat_imatge":"","hashtag":"","codi_hashtag":"","audio_descripcio":"no","subtitulat_catala":"yes","subtitulat_vo":"no","logo":"33","reemissio":"yes","id_programa":"54136"}},{"@attributes":{"name":"oca1"},"ara_fem":{"codi_canal":"oca1","tipus":"tv","codi_op":"6011251","capitol":"4210","graella":"11504625","codi_programa":"517338","titol_programa":"Sessi\u00f3 de control a Salvador Illa","titol_capitol":"","titol_tdt":"Sessi\u00f3 de control a Salvador Illa","sinopsi":"","start_time":"2026-11-04T09:00:00+01:00","end_time":"2026-11-04T09:44:55+01:00","durada":"00:44:55","drets_cat":"yes","drets_esp":"yes","drets_mon":"yes","tematica":"32","classificacio":{"grup_id":"1","grup":"ACTUALITAT","subgrup_id":"15","subgrup":"RETRANSMISSIONS ACTUALITAT","tematica_dvb":"32"},"target_id":"4","target":"TOTS ELS P\u00daBLICS","codi_etic":"","qualificacions":"","destacat":"yes","destacat_text":"","destacat_imatge":"https:\/\/img.ccma.cat\/multimedia\/jpg\/3\/7\/1734380530473.jpg","hashtag":"","codi_hashtag":"","audio_descripcio":"no","subtitulat_catala":"no","subtitulat_vo":"no","logo":"3cat","reemissio":"no","contribucio":"no"},"despres_fem":""},{"@attributes":{"name":"oca2"},"ara_fem":"","despres_fem":""},{"@attributes":{"name":"oca3"},"ara_fem":"","despres_fem":""},{"@attributes":{"name":"oca4"},"ara_fem":"","despres_fem":""}]}