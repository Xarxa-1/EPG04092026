f3n. Tamb\u00e9 descobreix que en Niall va estar a punt de morir, i la visita del seu pare confirma que ha trobat la seva aut\u00e8ntica vocaci\u00f3 amb una ambici\u00f3 que no t\u00e9 l\u00edmits.","start_time":"2026-10-13T20:15:18+02:00","end_time":"2026-10-13T20:59:59+02:00","durada":"00:44:41","drets_cat":"yes","drets_esp":"yes","drets_mon":"no","tematica":"144","classificacio":{"grup_id":"3","grup":"DIVULGACI\u00d3","subgrup_id":"31","subgrup":"DOCUMENTAL DE DIVULGACI\u00d3","tematica_dvb":"144"},"target_id":"4","target":"TOTS ELS P\u00daBLICS","codi_etic":"TP","destacat":"no","destacat_text":"","destacat_imatge":"","hashtag":"","codi_hashtag":"","audio_descripcio":"no","subtitulat_catala":"yes","subtitulat_vo":"no","logo":"33","reemissio":"yes","id_programa":"64876"},"despres_fem":{"codi_canal":"c33","tipus":"tv","codi_op":"000000000000","capitol":"0","graella":"0","codi_programa":"0","titol_programa":"SENSE FI CANAL 33","titol_capitol":"","titol_tdt":"SENSE FI CANAL 33","sinopsi":"Sense Descripci\u00f3","start_time":"2026-10-13T20:59:59+02:00","end_time":"2026-10-13T21:02:32+02:00","durada":"00:02:33","drets_cat":"yes","drets_esp":"yes","drets_mon":"yes","tematica":"","classificacio":{"grup_id":"","grup":"","subgrup_id":"","subgrup":"","tematica_dvb":""},"target_id":"","target":"","codi_etic":"","destacat":"no","destacat_text":"","destacat_imatge":"","hashtag":"","codi_hashtag":"","audio_descripcio":"no","subtitulat_catala":"no","subtitulat_vo":"no","logo":".","reemissio":"no","id_programa":""}},{"@attributes":{"name":"oca1"},"ara_fem":{"codi_canal":"oca1","tipus":"tv","codi_op":"6017752","capitol":"2","graella":"11480090","codi_programa":"500089","titol_programa":"B\u00e0squet","titol_capitol":"- Oostende-FIATC Girona \/ Fiba Europe Cup \/ J2","titol_tdt":"B\u00e0squet - Oostende-FIATC Girona \/ Fiba Europe Cup \/ J2","sinopsi":"Els gironins visiten B\u00e8lgica per enfrontar-se amb el conjunt flamenc amb l'objectiu de sumar la segona vict\u00f2ria en dues 