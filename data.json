ributes":{"name":"sx3"},"ara_fem":{"codi_canal":"sx3","tipus":"tv","codi_op":"6013265","capitol":"18","graella":"11384061","codi_programa":"519159","titol_programa":"La fam\u00edlia Teix\u00f3-Guineu","titol_capitol":"L'atrapagats","titol_tdt":"La fam\u00edlia Teix\u00f3-Guineu - L'atrapagats","sinopsi":"En Pinxo i en Timbal descobreixen que la Guineta s'ha fet molt amiga d'en Gatmoix i en Gatmoll, els gats del poble, cosa que els sorpr\u00e8n, per\u00f2 que tamb\u00e9 els molesta, ja que ho consideren una tra\u00efci\u00f3. Per arribar al fons de la q\u00fcesti\u00f3 decideixen espiar-la.","start_time":"2026-10-04T04:02:16+02:00","end_time":"2026-10-04T04:14:11+02:00","durada":"00:11:55","drets_cat":"yes","drets_esp":"yes","drets_mon":"no","tematica":"85","classificacio":{"grup_id":"5","grup":"FICCI\u00d3","subgrup_id":"54","subgrup":"S\u00c8RIE DIBUIXOS ANIMATS","tematica_dvb":"85"},"target_id":"1","target":"INFANTIL","codi_etic":"TP","destacat":"no","destacat_text":"","destacat_imatge":"","hashtag":"","codi_hashtag":"","audio_descripcio":"no","subtitulat_catala":"yes","subtitulat_vo":"no","logo":"SX3","reemissio":"yes","id_programa":"61416"},"despres_fem":{"codi_canal":"sx3","tipus":"tv","codi_op":"6013265","capitol":"19","graella":"11384061","codi_programa":"519159","titol_programa":"La fam\u00edlia Teix\u00f3-Guineu","titol_capitol":"El dia dels grans bigotis","titol_tdt":"La fam\u00edlia Teix\u00f3-Guineu - El dia dels grans bigotis","sinopsi":"L'\u00e0via explica als nens que abans hi havia la tradici\u00f3 del dia dels grans bigotis. Aquella diada, els petits bigotis, \u00e9s a dir, els nens, explicaven als grans bigotis, els seus pares, com els trobaven de fant\u00e0stics. I la Guineta i els altres decideixen fer un regal sorpresa als seus pares. La Guineta es pensar\u00e0 un poema en qu\u00e8 retratar\u00e0 la Marguerite, i en Pinxo i en Timbal tallaran una escultura de l'Edmond. ","start_time":"2026-10-04T04:14:11+02:00","end_time":"2026-10-04T04:25:40+02:00","durada":"00:11:29","drets_cat":"yes","drets_esp":"yes","drets_mon":"no","tematica":"85","classificacio":{"grup_id":"5","grup":"FICCI\u00d3","subgrup_id":"54","subgrup":"S\u00c8RIE DIBUIXOS ANIMATS","tematica_dvb":"85"},"target_id":"1","target":"INFANTIL","codi_etic":"TP","destacat":"no","destacat_text":"","destacat_imatge":"","hashtag":"","codi_hashtag":"","audio_descripcio":"no","subtitulat_catala":"yes","subtitulat_vo":"no","logo":"SX3","reemissio":"yes","id_programa":"61416"}},{"@attributes":{"name":"c33"},"ara_fem":{"codi_canal":"c33","tipus":"tv","codi_op":"6015827","capitol":"1","graella":"11439271","codi_programa":"527315","titol_programa":"Arxip\u00e8lag blau","titol_capitol":"Praderies i arenals","titol_tdt":"Arxip\u00e8lag blau - Praderies i arenals","sinopsi":"Miquel Salamanca ens presenta en aquest primer cap\u00edtol de la s\u00e8rie 'Arxip\u00e8lag blau' dos dels ambients m\u00e9s caracter\u00edstics de les nostres aig\u00fces: els arenals i els alguers, el que es coneix tradicionalment com 'el blanc' i 'el negre'. Ens endinsarem als alguers o praderies de posid\u00f2nia per con\u00e8ixer el cicle vital d'aquesta planta marina, les seves funcions ecol\u00f2giques i les esp\u00e8cies que amaga entre les seves fulles. Ens sorprendr\u00e0 descobrir com els arenals, en aparen\u00e7a extensions des\u00e8rtiques, s\u00f3n plens de vida, amb esp\u00e8cies que han desenvolupat complexos sistemes de camuflatge i defensa. Ferrasses, agulletes, serpetons, peda\u00e7os, pops i moltes altres criatures marines seran protagonistes d'aquest cap\u00edtol. Per finalitzar acompanyarem G\u00e0dor Muntaner a la seva visita a s'Espardell, a la reserva marina dels Freus d'Eivissa i Formentera.","start_time":"2026-10-04T03:33:00+02:00","end_time":"2026-10-04T04:19:00+02:00","durada":"00:46:00","drets_cat":"yes","drets_esp":"yes","drets_mon":"yes","tematica":"144","classificacio":{"grup_id":"3","grup":"DIVULGACI\u00d3","subgrup_id":"31","subgrup":"DOCUMENTAL DE DIVULGACI\u00d3","tematica_dvb":"144"},"target_id":"4","target":"TOTS ELS P\u00daBLICS","codi_etic":"TP","destacat":"no","destacat_text":"","destacat_imatge":"","hashtag":"","codi_hashtag":"","audio_descripcio":"no","subtitulat_catala":"yes","subtitulat_vo":"no","logo":"33","reemissio":"yes","id_programa":"70997"},"despres_fem":{"codi_canal":"c33","tipus":"tv","codi_op":"6015827","capitol":"2","graella":"11439271","codi_programa":"527315","titol_programa":"Arxip\u00e8lag blau","titol_capitol":"Albuferes i aig\u00fces somes","titol_tdt":"Arxip\u00e8lag blau - Albuferes i aig\u00fces somes","sinopsi":"En aquest cap\u00edtol condu\u00eft per Miquel Salamanca seguirem el cam\u00ed de l'aigua, des de la pluja, passant pels torrents i les zones humides, fins a la vorera de la mar. Ens detindrem a un peculiar ecosistema d'aigua dol\u00e7a, a s'Albufera, on trobem esp\u00e8cies \u00faniques i amena\u00e7ades per la salinitzaci\u00f3. Seguint el cam\u00ed de l'anguila arribarem a la mar, on coneixerem les aig\u00fces somes, uns ambients litorals resguardats i de poca fond\u00e0ria, de gran import\u00e0ncia com a refugi, zona de cria i de creixement dels exemplars juvenils de moltes esp\u00e8cies de peixos. Aqu\u00ed trobem plantes marines com l'alguer\u00f3, algues \u00faniques al m\u00f3n i esp\u00e8cies tan peculiars com els serpetons i agulletes. Es tracta d'un ambient fr\u00e0gil que ha patit molt les transformacions de les nostres costes. Per finalitzar acompanyarem G\u00e0dor Muntaner per la badia de Fornells amb la bi\u00f2loga Emma Cebri\u00e1n.","start_time":"2026-10-04T04:19:00+02:00","end_time":"2026-10-04T04:59:00+02:00","durada":"00:40:00","drets_cat":"yes","drets_esp":"yes","drets_mon":"yes","tematica":"144","classificacio":{"grup_id":"3","grup":"DIVULGACI\u00d3","subgrup_id":"31","subgrup":"DOCUMENTAL DE DIVULGACI\u00d3","tematica_dvb":"144"},"target_id":"4","target":"TOTS ELS P\u00daBLICS","codi_etic":"TP","destacat":"no","destacat_text":"","destacat_imatge":"","hasht